FROM mcr.microsoft.com/dotnet/sdk:10.0 AS migration-build
WORKDIR /src

# Restore first so this layer is cached when only source code changes.
# Copy the shared build props and all project references needed for evaluation
# before restore; otherwise restore skips referenced projects and fails with
# NETSDK1013 because TargetFramework is defined in Directory.Build.props.
COPY Directory.Build.props Directory.Packages.props ./
COPY MarketPlace.ServiceDefaults/MarketPlace.ServiceDefaults.csproj MarketPlace.ServiceDefaults/
COPY MarketPlace.Api/MarketPlace.Api.csproj MarketPlace.Api/
RUN dotnet restore MarketPlace.Api/MarketPlace.Api.csproj

COPY . .

RUN dotnet tool install --tool-path /tools dotnet-ef --version 10.0.12

ENV ASPNETCORE_ENVIRONMENT=Production
ENV ConnectionStrings__Database="Host=localhost;Username=postgres;Password=build;Database=marketplace;Port=5432"

RUN mkdir -p /out && /tools/dotnet-ef migrations bundle \
    --project MarketPlace.Api/MarketPlace.Api.csproj \
    --startup-project MarketPlace.Api/MarketPlace.Api.csproj \
    --configuration Release \
    --target-runtime linux-x64 \
    --self-contained \
    --force \
    --output /out/efbundle

FROM mcr.microsoft.com/dotnet/runtime-deps:10.0 AS migrations
WORKDIR /app
COPY --from=migration-build /out/efbundle .
ENTRYPOINT ["/app/efbundle"]
